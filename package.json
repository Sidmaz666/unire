{
  "name": "unire",
  "version": "1.0.4",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --exec electron .",
    "server": "node index.js",
    "rebuild": "electron-rebuild --force --module-dir . --which-module better-sqlite3",
    "rebuild:clean": "npm uninstall better-sqlite3 && npm install better-sqlite3 && electron-rebuild --force --module-dir . --which-module better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "keywords": [],
  "author": "Sidmaz666",
  "license": "ISC",
  "description": "Control your computer from your phone: trackpad, keyboard and a live screen view with audio over your local network.",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "screenshot-desktop": "^1.15.6",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.unire.remote",
    "productName": "Unire Remote",
    "directories": {
      "output": "dist-binaries"
    },
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**/*",
      "**/screenshot-desktop/**/*"
    ],
    "files": [
      "**/*",
      "!dist/**/*",
      "!dist-binaries/**/*",
      "!.git/**/*",
      "!.cursor/**/*",
      "!docs/**/*",
      "!**/README.md"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "public/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
